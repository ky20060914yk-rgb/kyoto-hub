rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // A verified Kyoto University student. The email pattern is start-anchored
    // and forbids a further '@', so an address such as
    // "evil@evil.com@st.kyoto-u.ac.jp" or "a@st.kyoto-u.ac.jp.attacker.com"
    // cannot pass as a KU address. The address is lower-cased first, because
    // mail domains are case-insensitive and "A@ST.KYOTO-U.AC.JP" is the same
    // mailbox (M1).
    function kuVerified() {
      return signedIn()
        && request.auth.token.email is string
        && request.auth.token.email.lower().matches('^[^@]+@st[.]kyoto-u[.]ac[.]jp$')
        && request.auth.token.email_verified == true;
    }

    // A Kyoto University *address*, verified or not (I3). Reads are gated on
    // this rather than on `signedIn()`, because anyone can mint a Firebase
    // account through the Auth REST API and would otherwise be able to read
    // every collection in the project. `email_verified` is deliberately NOT
    // required here: a student who has signed up but not yet clicked the
    // confirmation link must still be able to browse the catalog and the
    // streams — only *writes* demand kuVerified().
    function kuDomain() {
      return signedIn()
        && request.auth.token.email is string
        && request.auth.token.email.lower().matches('^[^@]+@st[.]kyoto-u[.]ac[.]jp$');
    }

    function owns(uid) { return signedIn() && request.auth.uid == uid; }

    // Course catalog: readable by any KU address. Custom-course creation is
    // allowed for verified users; the validation below is the *shape the reader
    // requires* (C1) — CourseRepository casts `id` and `period`, so a doc that
    // is missing `id` or carries a non-int `period` would poison the whole
    // catalog load. `id` is pinned to the document id so the two can never
    // diverge. No edits/deletes.
    match /courses/{courseId} {
      allow read: if kuDomain();
      allow create: if kuVerified()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.university_id == 'kyoto_u'
        && request.resource.data.id == courseId
        // Client-created courses live in the `c_custom_<millis>` namespace
        // (what CourseRepository.addCustomCourse generates). Seeded catalog ids
        // are `c_<16 hex>`, written by Admin; the review-bonus trigger relies on
        // a client never being able to mint a catalog-looking id (P2-13).
        && courseId.matches('^c_custom_[0-9]+$')
        && request.resource.data.period is int
        && request.resource.data.period >= 1 && request.resource.data.period <= 5
        && request.resource.data.dayOfWeek in ['Mon', 'Tue', 'Wed', 'Thu', 'Fri']
        && request.resource.data.lecturer is string
        && request.resource.data.faculty is string
        && request.resource.data.courseKey is string;
      allow update, delete: if false;
    }

    // Catalog metadata (`meta/catalog` carries `version`), read once per session
    // by CourseRepository to decide whether its Firestore cache is stale. Only
    // the seeding script writes it, and that runs through the Admin SDK, which
    // bypasses rules entirely.
    match /meta/{doc} {
      allow read: if kuDomain();
      allow write: if false;
    }

    // Per-user documents. The `owns` disjunct is kept alongside `kuDomain()` so
    // that getUserProfile(uid) still works on the sign-in path, before the ID
    // token carrying the email claim has necessarily been refreshed.
    match /users/{uid} {
      allow read: if owns(uid) || kuDomain();
      // pendingReferralCode (P2-2) is only a hint the server validates later;
      // keep it a short plain string. Other users' docs are never writable.
      allow create, update: if owns(uid)
        && request.resource.data.get('pendingReferralCode', '') is string
        && request.resource.data.get('pendingReferralCode', '').size() <= 16;
      allow delete: if false;
    }

    // Timetables are private: the app only ever reads or writes the caller's
    // own document, so nobody else may see it.
    match /user_timetables/{uid} {
      allow read, write: if owns(uid);
    }

    // User-generated content: readable by signed-in users, created by verified
    // KU users as themselves, edited/removed by the author.
    //
    // Two narrow carve-outs let non-authors write:
    //   * `reports` alone, so a post can be flagged — verified KU only (I4), so
    //     an outsider Firebase account cannot mass-flag into the auto-delete
    //     below. The flag is append-only, exactly one entry per write, and the
    //     appended entry must be the caller's own uid (I7). Without that, a
    //     single account could write `reports: ['x','y','z']` in one update and
    //     then satisfy the >= 3 auto-delete below by itself; the append-only
    //     shape restores the intended cost of three distinct accounts and
    //     mirrors `app_store.reportPost()`, which appends the caller's uid and
    //     refuses to report twice. The "not already in `reports`" clause is
    //     what makes it one report per account: without it an account already
    //     in the array would still satisfy `hasAny([uid])` while appending
    //     someone else's uid, and could walk the array to 3 on its own;
    //   * (Plan 2A) the download counters are Function-only: no client may write
    //     `downloadCount`, and the author may not touch `filePaths` either;
    //   * delete once `reports` reaches 3, which is the app's auto-moderation
    //     (I2) — the client removes the post it just pushed over the threshold.
    // The author branch pins `authorId` and `university_id` (M5) so an author
    // cannot reassign authorship or move the post out of the university-scoped
    // streams, and forbids it from touching `reports` at all (I7) — otherwise
    // an author could clear the flags on their own post and dodge the
    // auto-moderation threshold. Reports are only ever cleared by removing the
    // whole document through the moderation delete path below.
    match /posts/{id} {
      allow read: if kuDomain();
      // Plan 2A: files live in the private bucket under resources/<uid>/. The
      // first path is checked here (rules cannot loop); the onPostCreated
      // trigger validates every path and deletes the post if any is bad.
      // `downloadCount` and `reports` cannot be pre-seeded.
      allow create: if kuVerified()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.university_id == 'kyoto_u'
        && request.resource.data.get('downloadCount', 0) == 0
        && request.resource.data.get('reports', []) == []
        && request.resource.data.filePaths is list
        && request.resource.data.filePaths.size() >= 1
        && request.resource.data.filePaths.size() <= 5
        && request.resource.data.filePaths[0] is string
        && request.resource.data.filePaths[0].matches('resources/' + request.auth.uid + '/.+');
      allow update: if signedIn()
        && ((resource.data.authorId == request.auth.uid
             && request.resource.data.authorId == resource.data.authorId
             && request.resource.data.university_id == resource.data.university_id
             && !request.resource.data.diff(resource.data).affectedKeys()
                  .hasAny(['reports', 'downloadCount', 'filePaths']))
            || (kuVerified()
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reports'])
                && request.resource.data.reports.size()
                     == resource.data.get('reports', []).size() + 1
                && request.resource.data.reports.hasAll(resource.data.get('reports', []))
                && request.resource.data.reports.hasAny([request.auth.uid])
                && !resource.data.get('reports', []).hasAny([request.auth.uid])));
      allow delete: if signedIn()
        && (resource.data.authorId == request.auth.uid
            || (kuVerified() && resource.data.get('reports', []).size() >= 3));
    }

    // Plan 2A: fulfilment is done by the onPostCreated trigger (Admin SDK), so
    // no client — not even the author — may write the fulfilment fields. The
    // author could otherwise point `fulfilledPostId` at any post and unlock it
    // for free. Create pins the request unfulfilled with no cost or reward.
    match /requests/{id} {
      allow read: if kuDomain();
      allow create: if kuVerified()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.get('isFulfilled', false) == false
        && request.resource.data.get('fulfilledPostId', null) == null
        && request.resource.data.get('costSpent', 0) == 0
        && request.resource.data.get('rewardPoints', 0) == 0;
      allow update: if signedIn()
        && resource.data.authorId == request.auth.uid
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['isFulfilled', 'fulfilledPostId', 'authorId']);
      allow delete: if signedIn() && resource.data.authorId == request.auth.uid;
    }

    match /textbook_requests/{id} {
      allow read: if kuDomain();
      allow create: if kuVerified() && request.resource.data.requesterId == request.auth.uid;
      allow update: if kuVerified();   // responder flips status; tightened in Phase 3
      allow delete: if false;
    }

    // A talk room is a two-party chat. Either participant may update it, but the
    // message log is append-only (M6): without the `hasAll` clause a participant
    // could replace `messages` wholesale and erase the other party's side of the
    // conversation — the same treatment `posts.reports` gets above.
    match /talk_rooms/{id} {
      allow read: if kuDomain();
      allow create: if kuVerified()
        && (request.resource.data.lenderId == request.auth.uid
            || request.resource.data.borrowerId == request.auth.uid);
      allow update: if signedIn()
        && (resource.data.lenderId == request.auth.uid
            || resource.data.borrowerId == request.auth.uid)
        && request.resource.data.get('messages', [])
             .hasAll(resource.data.get('messages', []));
      allow delete: if false;
    }

    match /transactions/{id} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;   // Plan 2A: legacy client-authored ledger, now read-only
    }

    // Write-only mailbox: users file inquiries, only the console/admin reads.
    match /inquiries/{id} {
      allow read: if false;
      allow create: if signedIn();
      allow update, delete: if false;
    }

    // One structured review per (course, author). The document id is
    // '<courseSlug>_<authorId>', so a user physically cannot hold two reviews for
    // the same course, and the id encodes the author. Read by any KU address;
    // written only by its author, verified. A non-author may append exactly their
    // own uid to `helpfulBy` and nothing else (the same append-only shape as
    // posts.reports). The author branch pins `authorId`, `courseKey` and
    // `university_id` so a review cannot be reassigned, moved onto another
    // course or handed to another university after the fact, re-validates
    // `rating` on every edit, and forbids the author from touching `helpfulBy`
    // at all. The append-only branch does not let them back in either: it now
    // excludes the review's own author outright (I3), so an author cannot vote
    // for themselves by any route. Because create additionally pins `helpfulBy`
    // to the empty list, that exclusion is absolute: an author cannot seed votes
    // at create time, and cannot reset an already-voted review by deleting and
    // re-creating it. (`helpfulBy` is a
    // *benefit* to its author, unlike `posts.reports`, so unlike `reports` it
    // must never start non-empty.)
    //
    // C1 — the id is pinned to `courseSlug`, not `courseKey`. A courseKey may
    // contain '/' (17 courses in the deployed catalog do) and a '/' in a
    // document id splits the path, so `reviews/<courseKey>_<uid>` would be a
    // 3-segment path this match block never sees (it falls through to the
    // catch-all deny). `courseSlug` is the client-side escape ('/' -> '%2F',
    // '%' -> '%25', see `Review.slug`); rules cannot compute it, so it is stored
    // on the document and pinned on edit alongside `courseKey`.
    match /reviews/{reviewId} {
      allow read: if kuDomain();
      allow create: if kuVerified()
        && reviewId == request.resource.data.courseSlug + '_' + request.auth.uid
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.university_id == 'kyoto_u'
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.helpfulBy == [];
      allow update: if signedIn()
        && ((resource.data.authorId == request.auth.uid
             && request.resource.data.authorId == resource.data.authorId
             && request.resource.data.courseKey == resource.data.courseKey
             // C1: pinned alongside courseKey — the doc id is derived from the
             // slug, so letting it drift would divorce the id from its field.
             // `.get()` on both sides so a document written before C1 (which
             // carries neither) is still editable rather than erroring out.
             && request.resource.data.get('courseSlug', '')
                  == resource.data.get('courseSlug', '')
             && request.resource.data.university_id == resource.data.university_id
             && request.resource.data.rating is int
             && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
             && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['helpfulBy']))
            || (kuVerified()
                // I3: the author may not vote for their own review. `helpfulBy`
                // feeds the マイページ 貢献 badge, so a self-vote is a user
                // inflating their own score; unlike `posts.reports` (a cost the
                // author may legitimately pay against themselves) there is no
                // honest reason to allow it. The UI disables the button too, but
                // this is the half that actually holds.
                && resource.data.authorId != request.auth.uid
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['helpfulBy'])
                && request.resource.data.helpfulBy.size()
                     == resource.data.get('helpfulBy', []).size() + 1
                && request.resource.data.helpfulBy.hasAll(resource.data.get('helpfulBy', []))
                && request.resource.data.helpfulBy.hasAny([request.auth.uid])
                && !resource.data.get('helpfulBy', []).hasAny([request.auth.uid])));
      allow delete: if signedIn() && resource.data.authorId == request.auth.uid;
    }

    // Per-course roll-up maintained client-side in the same transaction as a
    // review write (Phase 1 has no Cloud Functions). Trust-based: any verified KU
    // account may create or update any course's aggregate, so the counters are
    // only as honest as the client that wrote them — Phase 2 replaces this with a
    // Function-authored aggregate. What the rule *does* enforce is a shape floor:
    // the doc stays on `kyoto_u` and its two scalar counters stay non-negative
    // ints, so a crafted write cannot poison a reader with a negative or
    // non-numeric count. Deletion is forbidden outright — unlike a review, an
    // aggregate has no owner who could legitimately remove it, and dropping it
    // would silently zero a course's history. (This is *not* the `transactions`
    // tier: `transactions` forbids update as well as delete; here update is the
    // whole point of the collection.)
    // Both create and update allow counter-only writes (e.g., bumpPostCount with
    // merge: true) that omit review fields, using .get() defaults for absent fields.
    // The document id is `Review.slug(courseKey)` (C1), not the raw courseKey —
    // the wildcard is unused in the body, so no rule change follows from that,
    // but the name should not claim otherwise.
    match /course_stats/{statsId} {
      allow read: if kuDomain();
      allow create, update: if kuVerified()
        && request.resource.data.university_id == 'kyoto_u'
        && request.resource.data.get('reviewCount', 0) is int
        && request.resource.data.get('reviewCount', 0) >= 0
        && request.resource.data.get('ratingSum', 0) is int
        && request.resource.data.get('ratingSum', 0) >= 0;
      allow delete: if false;
    }

    // Credits (Plan 2A). Written ONLY by Cloud Functions (Admin SDK bypasses
    // rules). A user may read their own balance and their own ledger rows; the
    // ledger query must carry `where('uid', '==', <own uid>)`.
    match /credit_balances/{uid} {
      allow read: if owns(uid);
      allow write: if false;
    }
    match /credits_ledger/{ledgerId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // Invitation codes (P2-2): Admin-only. Explicit deny (also the catch-all's
    // answer) so codes can be neither read, listed nor enumerated by a client.
    match /invitation_codes/{code} {
      allow read, write: if false;
    }

    // One welcome/referral grant per email (P2-15): written by claimWelcome via
    // the Admin SDK only; the key is a hash of the address.
    match /welcome_claims/{key} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
